# 이 파일을 복사해 .env.local 을 만들고 값을 채운다.
# .env.local 은 이 PC에만 두고, 채팅·메일·메신저로 보내지 않는다.

# Graph API 버전 (예: v26.0). Meta 개발자 문서에서 현재 지원 버전을 확인한 뒤 입력
META_GRAPH_API_VERSION=

# Business Suite > 설정 > 시스템 사용자 > 비마이비 > 토큰 생성 으로 받은 값
META_ACCESS_TOKEN=

# 아래 두 값은 /api/meta/test 결과에서 확인한 뒤 채운다 (공개 식별자, 비밀값 아님)
META_PAGE_ID=
META_IG_USER_ID=

# 참고용 공개 식별자
META_APP_ID=2935154120216645
